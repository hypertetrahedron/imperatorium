        </mxCell>
        <mxCell id="d_hosting" value="&lt;b&gt;imperatorium/hosting.py&lt;/b&gt;&lt;br&gt;space_id / tab_id / labels, launch,&lt;br&gt;owns_terminal, close, &lt;b&gt;Restorer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="disp">
