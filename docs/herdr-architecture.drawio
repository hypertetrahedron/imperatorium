        <mxCell id="d_voice" value="&lt;b&gt;voice.py&lt;/b&gt;&lt;br&gt;records mic, Whisper (GPU) → text&lt;br&gt;start / stop / cancel, auto-expire" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="disp">
