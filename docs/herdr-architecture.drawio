        <mxCell id="d_ops" value="&lt;b&gt;session ops&lt;/b&gt; (when terminal.host = hc)&lt;br&gt;_hc_opener: New / Resume / Fork → hc tab&lt;br&gt;_type_into: ctrl+c, send --if idle&lt;br&gt;_close_row: hosting.close + forget&lt;br&gt;restore_hosted thread at serve start" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="disp">
