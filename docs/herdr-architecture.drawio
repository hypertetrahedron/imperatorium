<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.0">
  <diagram id="herdr-arch" name="Imperatorium + herdr">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Imperatorium ↔ herdr&lt;/b&gt; (branch herdr, option A: herdr-app mods)" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>

        <!-- ================= herdr-app ================= -->
        <mxCell id="app" value="herdr-app (GPU desktop window, JS mods)" style="swimlane;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="520" height="640" as="geometry" />
        </mxCell>
        <mxCell id="app_term" value="&lt;b&gt;Terminal panes&lt;/b&gt;&lt;br&gt;spaces / tabs / terminals&lt;br&gt;rendered from herdr-core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="app">
          <mxGeometry x="20" y="50" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mod_chat" value="&lt;b&gt;imperatorium-chat&lt;/b&gt;&lt;br&gt;follows focused hc terminal or sidebar pick&lt;br&gt;markdown, coloured Edit diffs, work line&lt;br&gt;Allow / Deny / answers for parked requests&lt;br&gt;Send · Queue · As typed · Dictate (F9)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="app">
          <mxGeometry x="260" y="50" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mod_sessions" value="&lt;b&gt;imperatorium-sessions&lt;/b&gt; (sidebar)&lt;br&gt;all sessions, waiting first, 5h/7d meters&lt;br&gt;click: focus hc terminal / point chat&lt;br&gt;renames imp- tabs; Matrix, History buttons" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="app">
          <mxGeometry x="20" y="200" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="mod_matrix" value="&lt;b&gt;imperatorium-matrix&lt;/b&gt;&lt;br&gt;floating window: chat matrix tiles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="app">
          <mxGeometry x="280" y="210" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mod_history" value="&lt;b&gt;imperatorium-history&lt;/b&gt;&lt;br&gt;search dialog: Resume / Fork" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="app">
          <mxGeometry x="280" y="290" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mod_shared" value="shared: client.js (loadConfig, api, post) · text.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="app">
          <mxGeometry x="20" y="380" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="app_cfg" value="&lt;b&gt;HERDR_APP_HOME&lt;/b&gt;&lt;br&gt;mods/imperatorium-*&lt;br&gt;layouts/imperatorium.json&lt;br&gt;imperatorium.json {url, token_file}&lt;br&gt;telemetry: false" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="app">
          <mxGeometry x="20" y="450" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="app_pick" value="shared state&lt;br&gt;&lt;i&gt;imperatorium.pick&lt;/i&gt;&lt;br&gt;(sidebar → chat)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="app">
          <mxGeometry x="300" y="450" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- ================= herdr-core ================= -->
        <mxCell id="core" value="herdr-core (hc server, per HC_SESSION)" style="swimlane;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="400" height="460" as="geometry" />
        </mxCell>
        <mxCell id="core_space" value="&lt;b&gt;space&lt;/b&gt; imp-&amp;lt;folder&amp;gt;-&amp;lt;sha6&amp;gt;  (one per project)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="core">
