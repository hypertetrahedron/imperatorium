        <!-- ================= dispatcher ================= -->
        <mxCell id="disp" value="Imperatorium dispatcher (dispatcher.py, 127.0.0.1:8792)" style="swimlane;html=1;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1120" y="80" width="540" height="780" as="geometry" />
        </mxCell>
        <mxCell id="d_api" value="&lt;b&gt;HTTP API&lt;/b&gt; (mods send X-Imperatorium-Herdr token, no Origin)&lt;br&gt;/api/sessions · /api/usage · /api/pending · /api/conversation&lt;br&gt;/api/dispatch · /api/queue · /api/typed · /api/decide&lt;br&gt;/api/matrix · /api/history · /api/resume · /api/dictate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="disp">
          <mxGeometry x="20" y="45" width="500" height="85" as="geometry" />
        </mxCell>
        <mxCell id="d_hook" value="&lt;b&gt;/hook&lt;/b&gt; + park endpoint&lt;br&gt;_hc_owned: verify hook came from an hc terminal (CLAUDE_PID + process table)&lt;br&gt;first verified hook → remember + label tab (forks send no SessionStart)&lt;br&gt;SessionEnd → forget (unless reason &quot;other&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="disp">
          <mxGeometry x="20" y="150" width="500" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d_hcore" value="&lt;b&gt;imperatorium/hcore.py&lt;/b&gt;&lt;br&gt;Core: wraps hc CLI, clean_env,&lt;br&gt;ensure() / leaked() checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="disp">
