        <!-- ================= legend ================= -->
        <mxCell id="legend" value="&lt;b&gt;Flows&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#d79b00&quot;&gt;━━&lt;/font&gt; mods ↔ dispatcher HTTP&lt;br&gt;&lt;font color=&quot;#9673a6&quot;&gt;━━&lt;/font&gt; Claude Code hooks → dispatcher&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;━━&lt;/font&gt; herdr-core control (app, hc CLI)&lt;br&gt;┄┄ files, config, local state&lt;br&gt;&lt;br&gt;&lt;b&gt;Restore at logon&lt;/b&gt;: restore_hosted → hcore.ensure() (clean core) → Restorer types &lt;i&gt;claude --resume&lt;/i&gt; into the kept shell, else a new terminal" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
