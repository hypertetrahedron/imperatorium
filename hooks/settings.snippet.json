{
  "_comment": "Reference only - `python setup_machine.py` (or `python hooks/install.py`) writes this for you with real paths, safely (it backs the file up first and refuses to clobber unrelated hooks). Paths are absolute because a hook runs with the session's cwd, not this project's.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "C:\\path\\to\\imperatorium\\hooks\\cc_hook.py"
            ],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "C:\\path\\to\\imperatorium\\hooks\\cc_hook.py"
            ],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input|elicitation_dialog|elicitation_url_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "C:\\path\\to\\imperatorium\\hooks\\cc_hook.py"
            ],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "C:\\path\\to\\imperatorium\\hooks\\cc_hook.py"
            ],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "C:\\path\\to\\imperatorium\\hooks\\cc_hook.py"
            ],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
