.venv/
__pycache__/
*.pyc
state.json
dispatcher.log
# This machine's settings. `imperatorium install` creates them from the
# *.example.json files, which are what the repository carries.
config.json
policy.json
# vendor/hidapi.dll is the official libusb/hidapi release binary.
# `imperatorium install` downloads it and checks its SHA-256.
vendor/
# Backups and temporaries `imperatorium install` leaves beside config.json.
*.bak
*.tmp
# Claude Code's per-project runtime files.
.claude/
# Windows Explorer's thumbnail cache.
Thumbs.db

# written by `herdr-app check` into a mod folder
herdr/mods/*/gpui-kit.d.ts
herdr/mods/*/jsconfig.json
/dist/

# Build and test leftovers
rust/voice/target/
build.log
.pytest_cache/
node_modules/
