.venv/
__pycache__/
*.pyc
state.json
dispatcher.log
# This machine's settings. setup_machine.py creates them from the
# *.example.json files, which are what the repository carries.
config.json
policy.json
# vendor/hidapi.dll is the official libusb/hidapi release binary.
# setup_machine.py downloads it and checks its SHA-256.
vendor/
# Backups and temporaries setup_machine.py leaves beside config.json.
*.bak
*.tmp
# Claude Code's per-project runtime files.
.claude/
