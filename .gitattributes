* text=auto
# Shell scripts must stay LF: they are piped straight into bash from GitHub.
*.sh text eol=lf
*.ps1 text eol=crlf
*.dll binary
# cmd.exe misreads labels and long lines in LF batch files.
*.cmd text eol=crlf
# The window's sources are compiled into the binary and hashed: bytes must not vary by checkout.
imperatorium/web/* text eol=lf
# Test data compared byte for byte: CRLF, lone CR and invalid UTF-8 in the
# synthetic transcripts are the point; goldens are exact recorded bytes.
rust/imperatorium/tests/fixtures/** -text
rust/imperatorium/tests/golden/** -text
